function getConfusionmatrix(area, prediction, actual){
  //prediction : Hansen
  //actual: fca
  // Werte < Threshhold 1 sonst 0
  var predictionPos = prediction.lte(fcaThreshhold);
  predictionPos = predictionPos.updateMask(predictionPos);
  var predictionNeg = prediction.gt(fcaThreshhold);
  predictionNeg = predictionNeg.updateMask(predictionNeg);
  Map.addLayer(predictionPos, {}, 'pos');
  Map.addLayer(predictionNeg, {}, 'neg');
  
  //true Positive -> prediction & actual pos
  var tpImg = predictionPos.eq(actual);
  tpImg = tpImg.updateMask(tpImg);
  Map.addLayer(tpImg, {}, 'tp')
  var tp = tpImg.reduceRegion(ee.Reducer.count(), area).values();
  
  //false Positive -> prediction pos, actual neg
  var fpImg = predictionPos.neq(actual);
  fpImg = fpImg.updateMask(fpImg);
  Map.addLayer(fpImg, {}, 'fp')
  var fp = fpImg.reduceRegion(ee.Reducer.count(), area).values();
  
  //false Negative -> prediction neg, actual pos
  var fnImg = predictionNeg.eq(actual)
  fnImg = fnImg.updateMask(fnImg);
  Map.addLayer(fnImg, {}, 'fn')
  var fn = fnImg.reduceRegion(ee.Reducer.count(), area).values();
  
  //true Negative -> prediction neg, actual neg
  var tnImg = predictionNeg.neq(actual)
  tnImg = tnImg.updateMask(tnImg);
  Map.addLayer(tnImg, {}, 'tn')
  var tn = tnImg.reduceRegion(ee.Reducer.count(), area).values();
  
  
  
  return ee.Dictionary.fromLists(['tp', 'fp', 'fn', 'tn'], ee.List([tp, fp, fn, tn]).flatten());
  
}

