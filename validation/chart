var col;

function groupImages(){
  col = s2data.map(function(img) {
    var month = ee.Date(img.get('system:time_start')).getRelative('month', 'year');
    var year = ee.Date(img.get('system:time_start')).get('year');
    var my = ee.String(month).cat(ee.String('_')).cat(ee.String(year));
    return img.set('month', month).set('year', year).set('my', my);
  });
}

function calcNDVI(image){
  var red = image.select('B4');
  var nir = image.select('B8');
  return image.addBands(ee.Image(nir.subtract(red)).divide(nir.add(red)).rename('NDVI'));
  /*
  return image.expression('(NIR - RED) / (NIR + RED)',
                             {'RED' : red,'NIR' : nir})
                             .rename('NDVI');*/
}



var ttt = s2data.filterDate('2018-01-01','2018-12-31')
