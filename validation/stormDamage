/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var fritzi = ee.FeatureCollection("projects/ee-fichtnej/assets/f2"),
    hansen = ee.Image("UMD/hansen/global_forest_change_2023_v1_11"),
    fcaImg = ee.Image("projects/ee-fichtnej/assets/friederieke_18"),
    exportGeo = 
    /* color: #d63000 */
    /* shown: false */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[8.533113883274236, 52.01936809952822],
          [8.533113883274236, 50.70236620161701],
          [10.406282828586736, 50.70236620161701],
          [10.406282828586736, 52.01936809952822]]], null, false);
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var utils = require('users/fichtnej/modules:fcaUtils');

Map.addLayer(fritzi, {color:"Teal"})

var viz = utils.getFCAviz();
var stormdamage = fcaImg.clip(fritzi);

Map.addLayer(hansen)
var noloss = hansen.select("lossyear");
Map.addLayer(noloss)
noloss = noloss.gt(15).and(noloss.lt(19)).unmask(0).not()
Map.addLayer(noloss)

var nodamage = fcaImg.updateMask(noloss)
Map.addLayer(nodamage, viz)

stormdamage = ee.Image(1).addBands(stormdamage)
nodamage = ee.Image(0).addBands(nodamage)
Map.addLayer(stormdamage)

var sampleOne = stormdamage.stratifiedSample({numPoints: 50000, scale:20, region: exportGeo})
// Export.table.toDrive(sampleOne)
var sampleTwo = nodamage.stratifiedSample({numPoints: 50000, scale:20, region: exportGeo})
Export.table.toDrive(sampleTwo)
