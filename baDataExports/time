// Funktionen

function getFCA(img){
  
  var image = ee.Image();
  return image.expression('RE4 * 0.3778 - RE1 * 0.3278 - SWIR * 0.2944',{
                            'RE1': img.select(['B5']),
                            'RE4': img.select(['B8A']),
                            'SWIR': img.select(['B11']),
                          }).rename('FCA');
}



