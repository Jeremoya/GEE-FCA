var cloudMask = require('users/fichtnej/modules:CloudMasks');
var vegMask = require('users/fichtnej/modules:VegMasks');

var img = s2Data.filterBounds(geometry)
                .filterDate("2020-06-01", "2020-08-01")
                .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',20))
                .map(cloudMask.S2CloudMask)
                .median()
                .updateMask(vegMask.createCopernicusMask("Total"))
                .select(["B5", "B8A", "B11"]);
                
img = img.updateMask(img.gt(300).and(img.lt(1640)))                
Map.addLayer(img)

