//Imports
var cloudMask = require('users/fichtnej/modules:CloudMasks');
var vegMask = require('users/fichtnej/modules:VegMasks');
var FCA = require('users/fichtnej/modules:fcaUtils');
var viz = FCA.getFCAviz();

//Funktionen
function getFCA(img){
  
  var image = ee.Image();
  return image.expression('RE4 * 0.3778 - RE1 * 0.3278 - SWIR * 0.2944',{
                            'RE1': img.select(['B5']),
                            'RE4': img.select(['B8A']),
                            'SWIR': img.select(['B11']),
                          }).rename('FCA');
}

//Globale Variablen
var dates = ee.DateRange('2022-06-01', '2023-07-01');
var refImg = eg.filter(ee.Filter.eq('month', 6)).first()//.select(['B5']);
//Satellite Data
var s2Data = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .filterDate(dates)
                    .map(cloudMask.S2CloudMask)
                    .map(function(img){
                    return img.updateMask(img.select(['SCL']).eq(ee.Image([4,5])).reduce(ee.Reducer.max()));
                    })
                    .select(['B5', 'B8A', 'B11'])
                    .median()
                    .updateMask(vegMask.createCopernicusMask('Evergreen'));

//"Truecolor" zum abgleich
var tc  = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .filterDate(dates)
                    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',20))
                    .map(cloudMask.S2CloudMask)
                    .select(['B4', 'B3', 'B2'])
                    .median();






//Einordnen der Beobachtung in Quantile
var comp = s2Data.gte(refImg);
var rcomp = comp.arrayReduce(ee.Reducer.sum(), [0]).arrayGet(0);
//Normierung
rcomp = rcomp.subtract(9.5).divide(9.5);
//Indexberechnung
var fcaIndex = getFCA(rcomp);
//Extremwerte
var fcaLow = fcaIndex.lte(-0.95).updateMask(fcaIndex.lte(-0.95));



/*
Map.addLayer(tc, {min: 0, max: 3000}, 'truecolor');
*/
Map.addLayer(refImg, {}, 'percs');
Map.addLayer(s2Data, {}, 's2Data');
Map.addLayer(comp, {}, 'comp');
Map.addLayer(rcomp, {min: 0, max: 19}, 'rcomp');
Map.addLayer(fcaIndex, viz, 'FCA');
Map.addLayer(fcaLow, {palette: ['orange']}, 'FCA-extreme-low');
