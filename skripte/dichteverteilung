function histoPercs(img){
  var histo = img.reduceRegion({reducer: ee.Reducer.histogram(32), geometry: img.geometry(1), scale: 10, maxPixels: 200000000});
  var pxCount = img.reduceRegion({reducer: ee.Reducer.count(), geometry: img.geometry(1), scale: 10, maxPixels: 200000000});

  print(pxCount)
  print(histo)
  
  var wd = ee.List(histo.get('histogram')).map(function(el) {return ee.Number(el).divide(pxCount.get('FCA_first'))})
  print(wd)
}
