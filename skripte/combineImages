var dd = ee.ImageCollection("projects/ee-fichtnej/assets/DD"),
    eg = ee.ImageCollection("projects/ee-fichtnej/assets/EG"),
    mx = ee.ImageCollection("projects/ee-fichtnej/assets/MX"),
    ov = ee.ImageCollection("projects/ee-fichtnej/assets/OV");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var monthNumbers = ee.List.sequence(1,12,1);

var combinedImages = ee.ImageCollection(monthNumbers.map(function(month){
  var mxImg = mx.filter(ee.Filter.eq('month', month)).first();
  var egImg = eg.filter(ee.Filter.eq('month', month)).first();
  var ddImg = dd.filter(ee.Filter.eq('month', month)).first();
  var ovImg = eg.filter(ee.Filter.eq('month', month)).first();
  var allImgs = ee.ImageCollection([mxImg, egImg, ddImg, ovImg]);
  allImgs = allImgs.reduce(ee.Reducer.firstNonNull());
  return allImgs.rename(['B5', 'B8A', 'B11']);
  
}));

print(combinedImages);
Map.addLayer(combinedImages.first());