var fcaThreshhold = 0;

function getConfusionmatrix(area, prediction, actual){
  
  // Werte < Threshhold 1 sonst 0
  prediction = prediction.lte(fcaThreshhold);
  var tpImg = prediction.eq(actual);
  var tp = tpImg.reduceRegion(ee.Reducer.count(), area);
  
  return tp;
  
}

