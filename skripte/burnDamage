var burnedAreas = ee.FeatureCollection("projects/ee-fichtnej/assets/modisbapoly"),
    portugalFCA = ee.Image("projects/ee-fichtnej/assets/portugal_2020_fca"),
    bounds = 
    /* color: #d63000 */
    /* shown: false */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[-9.7565924181, 42.52770927817651],
          [-9.7565924181, 36.843280314504206],
          [-6.1530767931, 36.843280314504206],
          [-6.1530767931, 42.52770927817651]]], null, false),
    romaniaFCA = ee.Image("projects/ee-fichtnej/assets/romania_2020_fca");
/***** End of imports. If edited, may not auto-convert in the playground. *****/

var viz = {min: -0.75, max: 0.5, palette: ['#660066', '#9900cc', '#cc00ff', '#ff00ff', '#ffff00', '#66ff66', '#00cc00', '#006600']};

var researchImage = romaniaFCA;
var bounds = researchImage.geometry();
Map.addLayer(bounds)



burnedAreas = burnedAreas.filterBounds(bounds).map(function(ft){
  var year = ee.String(ft.get('FIREDATE')).slice(0, 4);
  return ft.set('YEAR', year);
}).filter(ee.Filter.eq('YEAR', '2019'))

Map.addLayer(burnedAreas, {color: 'red'}, 'burn');


var fireDamage = researchImage.clip(burnedAreas);
var noDamage = researchImage.updateMask(fireDamage.unmask(-2).lt(-1))


Map.addLayer(fireDamage, viz, 'fireDamage')
Map.addLayer(noDamage, viz, 'noDamage')

var bHisto = ui.Chart.image.histogram({image:fireDamage, region: bounds, scale: 10, maxBuckets: 32, maxPixels: 10000000000})
var nHisto = ui.Chart.image.histogram({image:noDamage, region: bounds, scale: 10, maxBuckets: 32, maxPixels: 10000000000})
print(bHisto)
print(nHisto)

Map.centerObject(researchImage);