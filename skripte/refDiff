/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var grid = ee.FeatureCollection("projects/ee-fichtnej/assets/Qrfts"),
    px = ee.Image("projects/ee-fichtnej/assets/6_PIXEL_Evergreen_100m"),
    eg = ee.ImageCollection("projects/ee-fichtnej/assets/EG");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
//Imports
var cloudMask = require('users/fichtnej/modules:CloudMasks');
var vegMask = require('users/fichtnej/modules:VegMasks');


Map.addLayer(grid, {}, 'grid');
Map.addLayer(px, {}, 'egPx');
var egImg = eg.filter(ee.Filter.eq('month', 8)).first();
Map.addLayer(egImg, {}, 'egHex');

var diff = px.subtract(egImg)/*.abs()*/.select(['B8A']);
// Map.addLayer(diff, {}, 'diff');
var diffsum = diff.arrayReduce(ee.Reducer.sum(), [0]).divide(19).arrayGet(0);
Map.addLayer(diffsum, {min: -300, max: 300, palette: ['blue', 'white', 'red']}, 'diffsum');
Map.addLayer(diffsum.abs(), {min: 0, max: 300}, 'diffsum-abs');


var tc = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .map(cloudMask.S2CloudMask)
                    .map(function(img){
                     return img.updateMask(img.select(['SCL']).eq(4));
                     })
                    .filter(ee.Filter.calendarRange(6, 6, 'month'))
                    .median()
                    .updateMask(vegMask.createCopernicusMask('Evergreen'));
                    
Map.addLayer(tc.select(['B8A']), {min: 1800, max: 4500, palette: ['blue', 'white', 'red']}, 'tc-IR')    
Map.addLayer(tc.select(['B4','B3','B2']), {min: 0, max: 2000}, 'tc-RGB')    


