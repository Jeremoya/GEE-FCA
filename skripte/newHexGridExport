var hexGrid = function(proj, diameter) {
  // Distance from center to vertex
  var size = ee.Number(diameter).divide(Math.sqrt(3)) 
  
  var coords = ee.Image.pixelCoordinates(proj)
  var vals = {
    // Switch x and y here to get flat top instead of pointy top hexagons.
    x: coords.select("x"),
    u: coords.select("x").divide(diameter),  // term 1
    v: coords.select("y").divide(size),      // term 2
    r: ee.Number(diameter).divide(2),
  }
  //i = xi + yi / 3
  //xi = Aix + Biy | u - v | x/d - sqrt(3)*y/d
  //yi = Cix + Diy | x / r
  var i = ee.Image().expression("floor((floor(u - v) + floor(x / r))/3)", vals)
  //j = xj + yj / 3
  //xj = Ajx + Bjy | u + v
  //yj = Cjx + Djy | v - u
  var j = ee.Image().expression("floor((floor(u + v) + floor(v - u))/3)", vals)
  
  // Turn the hex coordinates into a single "ID" number.
  Map.addLayer(i, {min:-32, max: 31}, 'i')
  Map.addLayer(j, {min:-23, max: 22}, 'j')
  //long + leftshift(32) -> 32 bit x und 32 bit y
  var cells = i.add(j).add(i).rename("hexgrid");
  // var cells = i.long().leftShift(32).add(j.long()).rename("hexgrid");
  return cells
}

// Define a region for masking hexagons.
var region = ee.FeatureCollection('USDOS/LSIB_SIMPLE/2017')
    .filter("country_na == 'United States'")
    .union().first().geometry()

// Generate a hex grid and mask off cells that don't touch the region.
var grid = hexGrid(ee.Projection('EPSG:5070'), 300000).cast({hexgrid: 'int'})

var regionImg = ee.Image(0).byte().paint(region, 1)
Map.addLayer(grid, {min: -30, max: 30, palette : ['purple', 'blue', 'green', 'yellow', 'orange', 'red']});
var hexGrid = grid.addBands(grid).reduceToVectors({reducer : ee.Reducer.max(),
  geometry: ROI.geometry().convexHull(10000).buffer(300000), 
  scale: 1000,
  maxPixels	: 15157171632
  
})
hexGrid = hexGrid.map(function(ft){
  var area = ft.area(1);
  ft = ft.simplify(5000);
  return ft.set('gr', area);
}).filterBounds(ROI.geometry().convexHull(1000));
print(hexGrid);
