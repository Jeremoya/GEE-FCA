var burnedArea = cci.filterDate('2016-01-01', '2020-12-31');

// Use a circular palette to assign colors to date of first detection
var monthVis = {
  min: 1,
  max: 12,
  palette: ['darkblue', 'blue', 'red', 'yellow', 'blue']
};
var yearVis = {
  min: 2016,
  max: 2020,
  palette: ['blue', 'white', 'red']
};

var maxBA = burnedArea.map(function(img){
  var date = ee.Date(img.get('system:time_start'));
  var month = ee.Number(date.get('month'));
  var year = ee.Number(date.get('year'));
  img = img.select('BurnDate').gt(0).updateMask(img.select('ConfidenceLevel').gt(95));
  var monthImg = img.multiply(month).rename('burnMonth').cast({burnMonth:'int'});
  var yearImg = img.multiply(year).rename('burnYear').cast({burnYear:'int'});
  return monthImg.addBands(yearImg);
});

maxBA = maxBA.reduce(ee.Reducer.firstNonNull());


//Map.addLayer(maxBA, baVis, 'Burned Area');
Map.addLayer(maxBA.select('burnYear_first'), yearVis, 'year');
