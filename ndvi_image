var s2Data = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var cloudMask = require('users/fichtnej/modules:CloudMasks');
var indices = require('users/fichtnej/modules:IndexFunctions');

var img = s2Data.filterDate("2020-06-01", "2020-07-01")
                .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',60))
                .map(cloudMask.S2CloudMask)
                .median()
                
img = indices.calcIndex(false, "NDVI", img)                
                
Map.addLayer(img, {min: -0.3, max: 1, palette: ["blue", "white", "brown", "green"]})