// Berechnen eines neuen Bildes

function startCalc(){
  print('Start');
  
  var ddImg = createFCAImage(dd);
  var egImg = createFCAImage(eg);
  var mxImg = createFCAImage(mx);
  var ovImg = createFCAImage(ov);
  
  
  // Karte Aktualisieren
  Map.layers().reset();
  Map.addLayer(ddImg, viz, 'Deciduous Forest');
  Map.addLayer(egImg, viz, 'Evergreen Forest');
  Map.addLayer(mxImg, viz, 'Mixed Forest');
  Map.addLayer(ovImg, viz, 'Other Vegetation', false);
}

// Erstellen des Beobachtungsbildes
//jährlich/saisonal

// Aktualisieren des Zeitraumes für Beobachtungsbild
function updateDateRange(month){
  var startDate = ee.Date.fromYMD(year, month, 1);
  var endDate = startDate.advance(1, 'month');
  var dr = ee.DateRange(startDate, endDate);
  dates = dr;
  
}

function createObsImage(){
  
  var s2Data = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .filterDate(dates)
                    .map(cloudMask.S2CloudMask)
                    .map(function(img){
                    return img.updateMask(img.select(['SCL']).eq(ee.Image([4,5])).reduce(ee.Reducer.max()));
                    })
                    .select(['B5', 'B8A', 'B11'])
                    .median();
                    

  return s2Data;
}

function createRefImage(imgCol, oneMonth){
  
  imgCol = ee.ImageCollection(imgCol);
  return imgCol.filter(ee.Filter.eq('month', oneMonth)).first();
}


// Vergleich Beobachtung Referenz

function compareImages(ref, obs){
  
  //Einordnen der Beobachtung in Quantile
  var comp = obs.gte(ref);
  var rcomp = comp.arrayReduce(ee.Reducer.sum(), [0]).arrayGet(0);
  //Normierung
  rcomp = rcomp.subtract(9.5).divide(9.5);
  //Indexberechnung
  return getFCA(rcomp);
  
}

function createFCAImage(type){
  var retImg = month.map(function(oneMonth){
    
    updateDateRange(oneMonth);
    var img = createObsImage();
    var refDD = createRefImage(type, oneMonth);
    var fcaDD = compareImages(refDD, img);
    
    return fcaDD;
  });
  
  return ee.ImageCollection(retImg).median();
}

