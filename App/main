// Globale Variablen
var vert = ui.Panel.Layout.Flow('vertical');
var hor = ui.Panel.Layout.Flow('horizontal');
var classNames = ['1 (kritisch)', '2', '3', '4', '5', '6', '7', '8 (gut)'];//{min: -0.8, max: 0.5} ;
var palette = ['#660066', '#9900cc', '#cc00ff', '#ff00ff', '#ffff00', '#66ff66', '#00cc00', '#006600'];
var year = 2019;
var month = 7;
var dates = ee.DateRange('2019-07-01', '2019-08-01');


// Funktionen

// Erstellen eines Legendeneintrages
var makeLegendRow = function(name, color, mobileStyle) {
  // Create the label that is actually the colored box.
  var colorBox = ui.Label({
    style: {
      backgroundColor: color,
      // Use padding to give the box height and width.
      padding: mobileStyle ? '10px' : '8px',
      margin: '0 0 4px 0',
      border: 'solid 0.5px',
    }
  });

  // Create the label filled with the description text.
  var description = ui.Label({
    value: name,
    style: {margin: '0 0 4px 6px', fontSize: mobileStyle ? '16px' : '12px'},
  });

  return ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
};


// Anpassung an Bildschirmgröße
function configLayout(deviceInfo) {
  
  if (!deviceInfo.is_desktop || deviceInfo.width < 900) {
    
  } else {
    
  }
   
}

// Berechnen eines neuen Bildes

function startCalc(){
  print('Start');
}

// Erstellen des Beobachtungsbildes

function createObsImage(month){
  
  var s2Data = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .filterDate(dates)
                    .map(cloudMask.S2CloudMask)
                    .map(function(img){
                    return img.updateMask(img.select(['SCL']).eq(ee.Image([4,5])).reduce(ee.Reducer.max()));
                    })
                    .select(['B5', 'B8A', 'B11'])
                    .median()
                    .updateMask(vegMask.createCopernicusMask('Deciduous'));

  return s2Data;
}

// Aktualisieren des Zeitraumes für Beobachtungsbild
function updateDateRange(){
  var startDate = ee.Date.fromYMD(year, month, 1);
  var endDate = startDate.advance(1, 'month');
  var dr = ee.DateRange(startDate, endDate);
  dates = dr;
  print(dates);
  
}

//GUI
var panel = ui.Panel({style: {width: '300px', height: 'auto', textAlign: 'center'}});
var legend = ui.Panel({style: {width: 'auto', position : 'middle-left'}});
var infobox = ui.Panel();

// var years = ee.List.sequence(2017, 2022);

var years = ee.List.sequence(2017, 2022).map(function(year) {
  return {label: ee.Number(year).format('%.0f'), value: year };
});

var yearSelect = ui.Select({
  placeholder : '2019',
  items : years.getInfo(),
  onChange: function(value){
    
    year = value;
    print('year', year);
    updateDateRange();
    startCalc();
  }
});

var months = {May: 5, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Oct: 10};

var monthSelect = ui.Select({
  placeholder : 'Jul',
  items : Object.keys(months),
  onChange: function(key){
    month = months[key];
    print('month',month);
    updateDateRange();
    startCalc();
  }
});


var calcButton = ui.Button({
  label: 'Calculate FCA',
  style: {stretch: 'horizontal'},
  onClick: startCalc
});



for (var i = 0; i < classNames.length; i++) {
  legend.add(makeLegendRow(classNames[i], palette[i], false));
}
panel.setLayout(hor);
panel.add(yearSelect);
panel.add(monthSelect);
panel.add(calcButton);
Map.add(panel)
Map.add(legend)
Map.setLocked(false, 5, 18);


ui.root.onResize(configLayout);

