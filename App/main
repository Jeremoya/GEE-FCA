  if (!deviceInfo.is_desktop || deviceInfo.width < 900) {
    
  } else {
    
  }
   
}


// Berechnen eines neuen Bildes

function startCalc(baseMap){
  print('Start');
  
  var ddImg = createFCAImage(dd);
  var egImg = createFCAImage(eg);
  var mxImg = createFCAImage(mx);
  var ovImg = createFCAImage(ov);
  
  
  // Karte Aktualisieren
  baseMap.layers().reset();
  baseMap.addLayer(ddImg, viz, 'Deciduous Forest');
  baseMap.addLayer(egImg, viz, 'Evergreen Forest');
  baseMap.addLayer(mxImg, viz, 'Mixed Forest');
  baseMap.addLayer(ovImg, viz, 'Other Vegetation', false);
  print(baseMap.layers())

  
  
}


// Erstellen des Beobachtungsbildes
//jährlich/saisonal

// Aktualisieren des Zeitraumes für Beobachtungsbild
function updateDateRange(month){
  var startDate = ee.Date.fromYMD(year, month, 1);
  var endDate = startDate.advance(1, 'month');
  var dr = ee.DateRange(startDate, endDate);
  dates = dr;
  
}

function createObsImage(){
  
  var s2Data = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
                    .filterDate(dates)
                    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',60))
                    .map(cloudMask.S2CloudMask)
                    .map(function(img){
                      return img.updateMask(img.select(['SCL']).eq(ee.Image([4,5])).reduce(ee.Reducer.max()));
                    })
                    .select(['B5', 'B8A', 'B11'])
                    .mean();
                    

  return s2Data;
}

function createRefImage(imgCol, oneMonth){
  
  imgCol = ee.ImageCollection(imgCol);
  return imgCol.filter(ee.Filter.eq('month', oneMonth)).first();
}


// Vergleich Beobachtung Referenz

function compareImages(ref, obs){
  
  //Einordnen der Beobachtung in Quantile
  var comp = obs.gte(ref);
  var rcomp = comp.arrayReduce(ee.Reducer.sum(), [0]).arrayGet(0);
  //Normierung
  rcomp = rcomp.subtract(9.5).divide(9.5);
  //Indexberechnung
  return getFCA(rcomp);
  
}



function createFCAImage(type){
  var retImg = month.map(function(oneMonth){
    
    updateDateRange(oneMonth);
    var img = createObsImage();
    var refImg = createRefImage(type, oneMonth);
    var fcaImg = compareImages(refImg, img);
    
    return fcaImg;
  });
  
  return ee.ImageCollection(retImg).mean();
}

// Switch to normal Mode

function normalMode(){
  
  ui.root.widgets().reset([normalMap]);
  Map.centerObject(ee.Geometry.Point([10.59, 51.76]), 10)
  normalMap.centerObject(ee.Geometry.Point([10.59, 51.76]), 10)
  layerPanel.remove(checkBA)
  layerPanel.add(layerInformation)
  m1.remove(layerPanel)
  Map.add(layerPanel)

}

//Switch to example Mode

function exampleMode(){
  
  ui.root.clear()
  print("aoi", ee.Geometry(aoi.get('geo')))
  m1.centerObject(ee.Geometry(aoi.get('geo')), 12);
  m2.centerObject(ee.Geometry(aoi.get('geo')), 12);
  ui.root.widgets().reset([sp]);
  month = [4,5];
  year = aoi.get('start');
  startCalc(m1);
  m1.addLayer(ee.Geometry(aoi.get('geo')), {color: "red", opacity : 0.4}, "Burned Area (Copernicus EMS)")
  year = aoi.get('compareYear');
  startCalc(m2);
  m2.addLayer(ee.Geometry(aoi.get('geo')), {color: "red", opacity : 0.4}, "Burned Area (Copernicus EMS)")
  layerPanel.add(checkBA)
  layerPanel.remove(layerInformation)
  Map.remove(layerPanel)
  m1.add(layerPanel)
  
}

function reloadExample(newAOI){
  aoi = ee.Dictionary(AOIs.getAOI(newAOI));
  m1.centerObject(ee.Geometry(aoi.get('geo')), 12);
  m2.centerObject(ee.Geometry(aoi.get('geo')), 12);
  year = aoi.get('start');
  startCalc(m1);
  m1.addLayer(ee.Geometry(aoi.get('geo')), {color: "red", opacity : 0.4}, "Burned Area (Copernicus EMS)")
  year = aoi.get('compareYear');
  startCalc(m2);
  m2.addLayer(ee.Geometry(aoi.get('geo')), {color: "red", opacity : 0.4}, "Burned Area (Copernicus EMS)")
  //exampleMode();
  //return 1;
}

