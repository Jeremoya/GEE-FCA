var createMethodsPanel = function(){
  var methodsPanel = ui.Panel({style : {position: "top-center", width: "100%", height: "100%"}})
  var aggregationLabel = ui.Label({
    value: "Data aggregation and filtering",
    style : {fontSize : "35px", fontWeight: "bold", margin : "30px 0px 0px 15px"}
  })
  
  var aggregationText = ui.Label({
    value: "At the beginning, a rough pre-filtering is carried out using the geodata from European borders in order to obtain only images with pixels within Europe. "+
    "The ee.Filter.calenderRange is then used to group the data by month. By specifying month as the third argument, it is possible to filter for individual or multiple months. "+
    "As later observations are to be classified in data from the same month, each month is filtered separately here. "+
    "Then, for each month, the cloudy pixels are masked with the information from the QA60 band and, using the Sentinel2 scene classification, all pixels not classified as vegetation are also masked. " +
    "Each forest type is then masked separately using Copernicus Global Land Cover. "+
    "The result is a collection of images for each forest type that were all taken in the same month, but not necessarily in the same year, in which cloudy and non-vegetation pixels are masked out. "+
    "A median reducer is then applied to each of these ImageCollections to combine them into a single image with representative values for further processing.",
    style : {fontSize : "17px", width: "70%", margin :"15px"}
    
    }

  );
  
  var referenceLabel = ui.Label({
    value: "Reference data derivation",
    style : {fontSize : "35px", fontWeight: "bold", margin : "30px 0px 0px 15px"}
  })
  
  var referenceText = ui.Label({
    value: "The reference data is collected using a hex grid in order to later enable regional reference of observation pixels to the references. "+
    "For this purpose, the reducer ee.Image.reduceRegions is used in the implementation on each of the images created using the method described above. "+
    "In addition to the reducer, a geometry collection - in this case the hexagonal grid - is also passed as an argument. "+
    "For each element of the collection - in this case the grid cells - the specified quantiles are then determined for all pixels within the geometry. "+
    "After selecting the relevant bands B5, B8A and B11, the quantiles determined in this way are then saved in the form of arrays "+
    "in each vegetation pixel.",
    style : {fontSize : "17px", width: "70%", margin :"15px"}
    
    }

  );
  
  
  methodsPanel.add(aggregationLabel)
  methodsPanel.add(aggregationText)
  return(methodsPanel)
}

Map.add(createMethodsPanel())

