// Erstellen eines Legendeneintrages
var makeLegendRow = function(name, color, mobileStyle) {
  // Create the label that is actually the colored box.
  var colorBox = ui.Label({
    style: {
      backgroundColor: color,
      // Use padding to give the box height and width.
      padding: mobileStyle ? '10px' : '8px',
      margin: '0 0 4px 0',
      border: 'solid 0.5px',
    }
  });

  // Create the label filled with the description text.
  var description = ui.Label({
    value: name,
    style: {margin: '0 0 4px 6px', fontSize: mobileStyle ? '16px' : '12px'},
  });

  return ui.Panel({
    widgets: [colorBox, description],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
};


exports.createLegend = function(classes, colorPalette){
  
  var legend = ui.Panel({style: {width: 'auto', position : 'top-left'}});
  var heading = ui.Label("FCA-Index values")
  legend.add(heading)
  for (var i = 0; i < classNames.length; i++) {
    legend.add(makeLegendRow(classes[i], colorPalette[i], false));
  }
  return legend;
}



