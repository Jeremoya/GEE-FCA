  })
  
  var referenceText = ui.Label({
    value: "The reference data is collected using a hexagonal grid in order to later enable regional reference of observation pixels to the references. "+
    "For this purpose, the reducer ee.Image.reduceRegions in combination with the ee.Reducer.percentiles is used in the implementation on each of the images created using the method described above. "+
    "In addition to the reducer, a geometry collection - in this case the hexagonal grid - is also passed as an argument. "+
    "For each element of the collection - in this case the grid cells - the specified quantiles are then determined for all pixels within the geometry. "+
    "After selecting the relevant bands B5, B8A and B11, the quantiles determined in this way are then saved as an image in the form of arrays "+
    "in each vegetation pixel.",
    style : {fontSize : "17px", width: "70%", margin :"15px"}
    
    }

  );
  
  var ForestConditionLabel = ui.Label({
    value: "Forest Condition Anomaly Index",
    style : {fontSize : "35px", fontWeight: "bold", margin : "30px 0px 0px 15px"}
  })
  
  var FCAText = ui.Label({
    value: "As a result of the previous step, we now have an array with quantile values in each vegetation pixel. "+
            "To do this, we now take a specific observation image whose pixel values are assigned to the quantiles. "+
            "Depending on the quantile into which the pixel value is placed, we can estimate whether there is an upward or downward deviation compared to the reference. "+
            "If this is done for several spectral bands, these deviations can be used to make statements about the condition of the forest in this pixel.",
    style : {fontSize : "17px", width: "70%", margin :"15px"}
    
    }

  );
  
  var ValidationLabel = ui.Label({
    value: "Data Validation",
    style : {fontSize : "35px", fontWeight: "bold", margin : "30px 0px 0px 15px"}
  })
  
  var ValidationText = ui.Label({
    value: "Various forest monitoring products were used for the validation."+
            "The central product are the Global Forest Change maps by Hansen et al."+
            "The FCA values of pixels in which forest loss occurred were compared with those without forest loss."+
            "Pixels that were degraded in the 5 years prior to the creation of an FCA image were considered."+
            "A precision of over 73% and a recall of over 74% were achieved for these pixels."+
            "Possible sources of error are noise in the data, new growth of vegetation and incorrect classification of pixels without vegetation.",
    style : {fontSize : "17px", width: "70%", margin :"15px"}
    
    }

  );
  
  methodsPanel.add(climateLabel)
  methodsPanel.add(climateText)
  methodsPanel.add(aggregationLabel)
  methodsPanel.add(aggregationText)
  methodsPanel.add(referenceLabel)
  methodsPanel.add(referenceText)
  methodsPanel.add(ForestConditionLabel)
